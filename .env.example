DATABASE_URL="file:./dev.db"
SESSION_SECRET="genera-uno-con-openssl-rand-base64-32"

# Seed
SEED_ADMIN_EMAIL="admin@tiquera.local"
SEED_ADMIN_PASSWORD="Admin12345"
SEED_AGENT_EMAIL="agente@tiquera.local"
SEED_AGENT_PASSWORD="Agente12345"

# SLA en background (opcional; sin Redis funciona el barrido perezoso)
REDIS_URL="redis://127.0.0.1:6379"
DISABLE_SLA_WORKER="false"

# Formspree: recibe los formularios y los avisos internos al Gmail del equipo.
FORMSPREE_ENDPOINT="https://formspree.io/f/xbggpklg"

# Correo transaccional principal con Resend:
# Crea tu API Key en https://resend.com y colócala aquí.
# Remitente: usa 'Tiquera Web <onboarding@resend.dev>' para pruebas o tu dominio verificado.
RESEND_API_KEY=""
MAIL_FROM="Tiquera Web <onboarding@resend.dev>"
STAFF_NOTIFICATION_EMAIL=""

# Correo alternativo (Gmail SMTP o Mailtrap para desarrollo):
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
MAILTRAP_USER=""
MAILTRAP_PASS=""

# Almacenamiento de adjuntos (opcional; sin Cloudinary usa public/uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="tiquera/attachments"
